{
  "name": "clawd-mini",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Mascote de desktop que reage ao Claude Code",
  "main": "dist/src/main/main.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "npm run build && node scripts/start.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
